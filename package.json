{
  "name": "sample-vue",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "format": "prettier --write .",
    "test": "npm run test:format && npm run test:types && npm run test:lint && npm run test:deps && npm run test:unit",
    "test:types": "vue-tsc --build",
    "test:unit": "vitest run --passWithNoTests",
    "test:unit:watch": "vitest watch --test-timeout 0",
    "test:deps": "depcruise --config ./dependency-cruiser.config.cjs ./src",
    "test:format": "prettier --check .",
    "test:lint": "oxlint --max-warnings=0 . && eslint --format=codeframe --max-warnings=0 ./",
    "deps:graph": "depcruise --config ./dependency-cruiser.config.cjs ./src --include-only '^src' --exclude '(.factory|test(s?)|spec(s?)|types|utils)' --collapse 5  --output-type dot | dot -T svg > ./dependency-graph.svg"
  },
  "dependencies": {
    "@tanstack/vue-query": "^5.104.5",
    "factory-t": "^2.0.0",
    "vue": "^3.5.42"
  },
  "devDependencies": {
    "@esfx/async-deferred": "^1.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tsconfig/node24": "^24.0.5",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.13.4",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/eslint-plugin": "^1.6.27",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.5.0",
    "@vue/tsconfig": "^0.9.1",
    "daisyui": "^5.7.50",
    "dependency-cruiser": "^18.7.0",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-formatter-codeframe": "^7.32.2",
    "eslint-plugin-oxlint": "~1.82.0",
    "eslint-plugin-vue": "~10.11.0",
    "jiti": "^2.7.0",
    "jsdom": "^30.0.1",
    "msw": "^2.15.0",
    "oxlint": "~1.82.0",
    "prettier": "3.9.6",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.0",
    "vite": "^8.2.2",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vitest": "^4.1.11",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.11"
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  }
}
